# Copy this file to .env and fill in real values before running any import
# scripts. Never commit the real .env file (it's already in .gitignore).

# Your Supabase project's API URL.
# Find it in the Supabase dashboard: Project Settings > API > Project URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key -- has full read/write access, bypassing Row
# Level Security. Only used by server-side import scripts, never exposed to
# a browser/frontend. Find it in the Supabase dashboard: Project Settings >
# API > Project API keys > service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase anon (public) key -- respects Row Level Security, unlike
# SUPABASE_SERVICE_ROLE_KEY above. Safe to expose client-side; used here
# for client-side or anon-scoped reads. Find it in the Supabase dashboard:
# Project Settings > API > Project API keys > anon public.
SUPABASE_ANON_KEY=your-anon-key

# Socrata app token for Seattle's open data API (Paid Parking Occupancy and
# its yearly archives). Free -- register at https://data.seattle.gov.
# Without one, requests share Socrata's much lower anonymous rate limit
# with every other unauthenticated caller; with one, requests get their own
# per-token limit instead. Optional for occasional one-off scripts, but
# needed for the volume of requests the occupancy batch aggregation job
# makes (see CLAUDE.md's Architecture section). Requests still work without
# this set, just at that lower, shared rate limit.
SOCRATA_APP_TOKEN=your-socrata-app-token

# LocationIQ API key -- this project's forward/reverse geocoding provider
# (geocodeAddress.ts, reverseGeocodeCoordinates.ts), replacing Nominatim
# entirely rather than supplementing it (see CLAUDE.md's Architecture
# section: Nominatim's 1-request/second cap doesn't realistically scale to
# this app's intended usage; LocationIQ is OSM-data-backed with a much
# higher free tier and no card required). Free -- register at
# https://locationiq.com. NOT used by destination-autocomplete or
# resolve-destination -- those use Google Places/Geocoding instead (see
# GOOGLE_PLACES_API_KEY below), following a real, confirmed LocationIQ
# Autocomplete-specific bug (see CLAUDE.md's Known open questions).
LOCATIONIQ_API_KEY=your-locationiq-api-key

# Google Places API key -- used by destination-autocomplete (Places API
# (New) Autocomplete) and resolve-destination (the classic Geocoding API's
# place_id lookup mode). Must be a REAL, billing-enabled key on a Google
# Cloud project with both "Places API (New)" and "Geocoding API" enabled --
# never GOOGLE_MAPS_DEMO_KEY below, which is explicitly test-only per
# Google's own docs and not meant for production traffic. See CLAUDE.md's
# Known open questions for the full context behind this choice.
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Google Maps "Demo Key" -- no credit card required, real but explicitly
# test-only (per Google's own docs, not designed for production use). Used
# only for manual/local evaluation of Google's autocomplete quality before
# committing to real billing setup -- never read by any deployed Edge
# Function. Free -- see mapsplatform.google.com/maps-demo-key.
GOOGLE_MAPS_DEMO_KEY=your-google-maps-demo-key
